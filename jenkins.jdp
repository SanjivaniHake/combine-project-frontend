pipeline {
    agent any
    stages {
        stage ('pull') {
            steps {
               git branch: 'dev', url: 'https://github.com/SanjivaniHake/combine-project-frontend.git'

            }
        }
        stage ('build') {
            steps {
                sh '''
                npm install
                ng build
                ''' 

            }
        }
        stage ('deploy') {
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws-cred', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                aws s3 cp --recursive dist/angular-frontend/ s3://cbz-frontend-project-sanju-23-01/
        }

            }
        } 
    }
}